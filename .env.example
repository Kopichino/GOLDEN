# ==============================================================================
# GOLDEN Environment Configuration (.env.example)
# Guideline-Grounded Orchestrated LLM Dispatch for Emergency Networks
# ==============================================================================

# Docker & Platform
DOCKER_DEFAULT_PLATFORM=linux/amd64

# Local HAPI FHIR R4 Server
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_TIMEOUT_SECONDS=10

# Hosted LLM Provider Keys
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Voice and Exotel configuration. Keep empty until the NEW account is configured.
VOICE_SIMULATION_ONLY=true
VOICE_CALLBACK_URL=http://localhost:8000/webhook/call-outcome
VOICE_CALLBACK_SECRET=
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
EXOTEL_CALL_FLOW_URL=
EXOTEL_STREAM_URL=
EXOTEL_STATUS_CALLBACK_URL=
EXOTEL_RECORD_CALLS=false
EXOTEL_TIMEOUT_SECONDS=15
EXOTEL_APP_ID=
# Gemini Live model used for the family voice agent. gemini-3.1-flash-live-preview
# is the validated low-latency default; check available models with your API key.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE_NAME=Zephyr
# Realtime turn-detection tuning (milliseconds). Lower VOICE_SILENCE_DURATION_MS
# reduces response latency but may cut off callers who pause mid-sentence.
VOICE_PREFIX_PADDING_MS=100
VOICE_SILENCE_DURATION_MS=300
VOICE_SERVER_HOST=127.0.0.1
VOICE_SERVER_PORT=8765
VOICE_SERVER_PATH=/ws
CALLBACK_RETRY_ATTEMPTS=3
CALLBACK_RETRY_BACKOFF_SECONDS=2
VOICE_CALL_TIMEOUT_SECONDS=300
N8N_CALL_RESULT_WEBHOOK_URL=
TEAM_CONSENT_PHONE_NUMBERS=

# Local Offline Fallback (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Orchestrator & Safety Settings
HARD_SOS_BYPASS_ENABLED=true
SCHEMA_MAX_RETRIES=3
DEFAULT_LLM_PROVIDER=groq
