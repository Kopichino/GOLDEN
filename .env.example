# ==============================================================================
# GOLDEN Environment Configuration (.env.example)
# Guideline-Grounded Orchestrated LLM Dispatch for Emergency Networks
# ==============================================================================

# Docker & Platform
DOCKER_DEFAULT_PLATFORM=linux/amd64

# Local HAPI FHIR R4 Server
FHIR_BASE_URL=http://localhost:8080/fhir
FHIR_TIMEOUT_SECONDS=10

# Hosted LLM Provider Keys (Free-tier inference)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Telephony (Exotel) & Voice Bridge
EXOTEL_ACCOUNT_SID=your_exotel_sid_here
EXOTEL_API_KEY=your_exotel_key_here
EXOTEL_API_TOKEN=your_exotel_token_here
EXOTEL_SUBDOMAIN=api.exotel.com
EXOTEL_CALLER_ID=0XXXXXXXXX
TEAM_CONSENT_PHONE_NUMBERS=+919876543210,+919876543211

# Local Offline Fallback (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Orchestrator & Safety Settings
HARD_SOS_BYPASS_ENABLED=true
SCHEMA_MAX_RETRIES=3
DEFAULT_LLM_PROVIDER=groq
